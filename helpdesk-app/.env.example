# Copy to .env (never commit .env). All values below are placeholders for LOCAL development only.

# ---- Backend ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# postgres://USER:PASSWORD@HOST:PORT/DB
DATABASE_URL=postgres://helpdesk:change-me@localhost:5432/helpdesk
# Used only by the backend test suite
DATABASE_URL_TEST=postgres://helpdesk:change-me@localhost:5432/helpdesk_test
# Set to "true" when the DB requires TLS (Azure PostgreSQL)
DB_SSL=false
# At least 32 random characters. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Keep true; browsers accept Secure cookies on http://localhost
COOKIE_SECURE=true

# ---- Seed script (dev only) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=choose-a-long-dev-password
SEED_USER_PASSWORD=choose-another-long-dev-password

# ---- docker-compose Postgres ----
POSTGRES_USER=helpdesk
POSTGRES_PASSWORD=change-me
POSTGRES_DB=helpdesk
